# ChromaDB vector store, rebuilt by load_knowledge_base.py
chroma_data/

# Student output written by the agents at runtime
student_work/

# Packaged lab bundle, regenerated for distribution
*.zip

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

